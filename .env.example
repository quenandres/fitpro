# === Local Postgres (Docker) — hoy ===
# Usado por fitpro_api (DATABASE_URL en ../fitpro_api/.env)
# Para psql directo: postgresql://fitpro:fitpro@localhost:5432/fitpro
DATABASE_URL=postgresql://fitpro:fitpro@localhost:5432/fitpro

# === Supabase (futuro) — cuando migres, reemplaza DATABASE_URL por el pooler ===
# Ej: DATABASE_URL=postgresql://postgres.<ref>:<pass>@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_API_URL=http://localhost:8000
VITE_RAPIDAPI_KEY=your-rapidapi-key

# Thunder Client / API testing
TC_BASE_URL=https://your-project.supabase.co
TC_API_KEY=your-anon-key
TC_EMAIL=someone@email.com
TC_PASSWORD=your-password
